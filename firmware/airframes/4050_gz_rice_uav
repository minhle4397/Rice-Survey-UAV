#!/bin/sh
#
# @name Rice Survey UAV (Gazebo)
#
# @type Quadrotor
# @class Copter
#
# 450 mm quadrotor, X configuration. Simulation model: simulation/models/rice_uav
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=rice_uav}

param set-default SIM_GZ_EN 1

# --- Control allocation: rotor geometry --------------------------------------
# PX4 body frame is FRD (x forward, y right, z down). Positions in metres.
# Motor offset = arm length / sqrt(2) = 0.225 / 1.414 = 0.159 m.
# KM > 0: CCW rotor, KM < 0: CW rotor.
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

# Motor 1: front-right, CCW
param set-default CA_ROTOR0_PX 0.159
param set-default CA_ROTOR0_PY 0.159
param set-default CA_ROTOR0_KM 0.05

# Motor 2: rear-left, CCW
param set-default CA_ROTOR1_PX -0.159
param set-default CA_ROTOR1_PY -0.159
param set-default CA_ROTOR1_KM 0.05

# Motor 3: front-left, CW
param set-default CA_ROTOR2_PX 0.159
param set-default CA_ROTOR2_PY -0.159
param set-default CA_ROTOR2_KM -0.05

# Motor 4: rear-right, CW
param set-default CA_ROTOR3_PX -0.159
param set-default CA_ROTOR3_PY 0.159
param set-default CA_ROTOR3_KM -0.05

# --- Simulated ESC outputs ----------------------------------------------------
# Functions 101..104 = Motor 1..4. MIN/MAX are rotor speeds in rad/s;
# MAX must equal maxRotVelocity in model.sdf.
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104

param set-default SIM_GZ_EC_MIN1 150
param set-default SIM_GZ_EC_MIN2 150
param set-default SIM_GZ_EC_MIN3 150
param set-default SIM_GZ_EC_MIN4 150

param set-default SIM_GZ_EC_MAX1 838
param set-default SIM_GZ_EC_MAX2 838
param set-default SIM_GZ_EC_MAX3 838
param set-default SIM_GZ_EC_MAX4 838

# --- Mission defaults (thesis spec) -------------------------------------------
# Hover thrust estimate: (478 - 150) / (838 - 150) = 0.48. PX4 refines it in flight.
param set-default MPC_THR_HOVER 0.48
# Nominal survey altitude 6 m AGL.
param set-default MIS_TAKEOFF_ALT 6
# Return to launch when the GCS link is lost.
param set-default NAV_DLL_ACT 2